        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"inbox_id\": {{ Number($('Config CRM').first().json.chatwoot_inbox_id) }},\n  \"name\": {{ JSON.stringify($('Monta Resumo').first().json.nome) }},\n  \"phone_number\": {{ JSON.stringify($('Monta Resumo').first().json.telefone_e164) }},\n  \"identifier\": {{ JSON.stringify($('Monta Resumo').first().json.telefone_digits) }}\n}"
