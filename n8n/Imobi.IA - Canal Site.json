    {
      "parameters": {
        "jsCode": "// a fila vem do Redis, nao do item que chega neste node.\n// era esse o bug: $input.all() traz 1 item so, ignorando o agrupamento.\nconst base = $('Extrai Dados').first().json;\nconst bruto = $('Lê Lista de Mensagens').first().json.fila;\nconst lista = Array.isArray(bruto) ? bruto : (bruto ? [bruto] : []);\n\nconst mensagem = lista.filter(Boolean).join('\\n') || base.conteudo;\n\nreturn [{\n  json: {\n    mensagem,\n    session_id: 'site_' + base.conversation_id,\n    nome: base.nome,\n    telefone: base.telefone,\n    canal: 'site',\n    conversation_id: base.conversation_id,\n  },\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
