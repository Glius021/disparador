          "name": "Chatwoot API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst inboxId = String($('Config CRM').first().json.chatwoot_inbox_id);\nconst fallbackSource = $('Monta Resumo').first().json.telefone_digits;\n\n// a busca devolve payload como array; a criacao devolve payload.contact\nlet contact = null;\nif (Array.isArray(j.payload)) contact = j.payload[0] || null;\nelse if (j.payload && j.payload.contact) contact = j.payload.contact;\nelse if (j.payload && j.payload.id) contact = j.payload;\nelse if (j.id) contact = j;\n\nif (!contact || !contact.id) {\n  throw new Error('Chatwoot: nao foi possivel obter o contato. Resposta: ' + JSON.stringify(j).slice(0, 500));\n}\n\nconst inboxes = contact.contact_inboxes || [];\nconst match = inboxes.find((ci) => String((ci.inbox && ci.inbox.id) || ci.inbox_id) === inboxId) || inboxes[0];\n\nreturn [{\n  json: {\n    contact_id: contact.id,\n    source_id: (match && match.source_id) ? match.source_id : fallbackSource,\n  },\n}];\n"
      },
