      "parameters": {
        "jsCode": "const msgs = $input.all().map((i) => i.json.conteudo).filter(Boolean);\nconst last = $input.last().json;\n\nreturn [{\n  json: {\n    mensagem: msgs.join('\\n'),\n    session_id: 'site_' + last.conversation_id,\n    nome: last.nome,\n    telefone: last.telefone,\n    canal: 'site',\n    conversation_id: last.conversation_id,\n  },\n}];\n"
      },
