    {
      "parameters": {
        "jsCode": "// le direto do webhook pelo nome: nao depende de qual node roda antes\nconst b = $('Webhook Chatwoot').first().json.body || {};\nconst conv = b.conversation || {};\nconst sender = b.sender || {};\n\nreturn [{\n  json: {\n    event: b.event || '',\n    message_type: b.message_type || '',\n    private: b.private === true,\n    conteudo: (b.content || '').trim(),\n    conversation_id: String(conv.id || ''),\n    inbox_id: String(conv.inbox_id || (b.inbox && b.inbox.id) || ''),\n    nome: sender.name || sender.email || 'Visitante do site',\n    telefone: String(sender.phone_number || '').replace(/\\D/g, ''),\n    email: sender.email || '',\n  },\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        400
      ],
      "id": "fd8b0713-4cc8-426d-a446-b651e7058f42",
