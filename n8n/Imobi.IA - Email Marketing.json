    {
      "parameters": {
        "jsCode": "// Une as tres planilhas e decide, por lead, o que fazer nesta rodada:\n//   enviar        -> manda o email da etapa que estiver em aberto (1, 2 ou 3)\n//   marcar_engajado -> o lead abriu/clicou um email (apareceu em Lead Morno ou\n//                      Lead Quente): a cadencia para, sem mandar mais nada\n//   (nada)        -> ainda nao chegou a vez, ja terminou a cadencia, ou o lead\n//                      nao tem email valido / esta descadastrado\n//\n// A cadencia usa 3 colunas gravadas na propria BDD IMOB por este workflow:\n//   \"Email Etapa\"          0 (nunca enviado) | 1 | 2 | 3 | \"engajado\" | \"parou\"\n//   \"Email Data Envio\"     data/hora do ultimo envio (ISO)\n//   \"Email Descadastrado\"  TRUE quando o lead pediu para nao receber mais\nconst cfg = $('Config Email Marketing').first().json;\n\nconst num = (v, padrao) => { const n = Number(v); return Number.isFinite(n) ? n : padrao; };\nconst int2 = num(cfg.intervalo_email_2_dias, 3);\nconst int3 = num(cfg.intervalo_email_3_dias, 7);\n\n// Emails que ja abriram ou clicaram algum email — a cadencia para para eles,\n// porque o objetivo do disparo (reengajar) ja foi cumprido.\nconst normEmail = (e) => String(e || '').trim().toUpperCase();\nconst engajados = new Set();\nfor (const nome of ['Lê Lead Morno', 'Lê Lead Quente']) {\n  for (const item of $(nome).all()) {\n    const e = normEmail(item.json.Email);\n    if (e) engajados.add(e);\n  }\n}\n\n// Filtro basico de email obviamente invalido. A BDD IMOB e uma base\n// cadastral (Receita Federal), nao uma lista opt-in: muito email desatualizado\n// ou mal formatado gera bounce, e bounce em excesso queima o dominio no Brevo.\nconst EMAIL_OK = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/;\n\nconst diasDesde = (iso) => {\n  const d = new Date(iso);\n  if (isNaN(d.getTime())) return Infinity;\n  return (Date.now() - d.getTime()) / 86400000;\n};\n\nconst saida = [];\nfor (const item of $('Lê BDD IMOB').all()) {\n  const row = item.json;\n  const emailBruto = String(row['CORREIO ELETRONICO'] || '').trim();\n  const emailNorm = normEmail(emailBruto);\n  if (!emailBruto || !EMAIL_OK.test(emailBruto)) continue;\n\n  const descadastrado = String(row['Email Descadastrado'] || '').trim().toUpperCase();\n  if (descadastrado === 'TRUE' || descadastrado === 'SIM' || descadastrado === 'X') continue;\n\n  const etapaAtual = String(row['Email Etapa'] || '0').trim();\n\n  const base = {\n    Cnpj: row.CNPJ,\n    email: emailBruto,\n    nome: String(row['NOME FANTASIA'] || row['RAZAO SOCIAL'] || '').trim(),\n    empresa: String(row['RAZAO SOCIAL'] || row['NOME FANTASIA'] || '').trim(),\n  };\n\n  // Engajou: marca e para, mesmo que ja estivesse marcado (idempotente) —\n  // exceto se ja estava \"engajado\" ou \"parou\", ai nao ha nada novo a gravar.\n  if (engajados.has(emailNorm)) {\n    if (etapaAtual !== 'engajado' && etapaAtual !== 'parou') {\n      saida.push({ json: { ...base, acao: 'marcar_engajado', etapa_nova: 'engajado' } });\n    }\n    continue;\n  }\n\n  if (etapaAtual === 'engajado' || etapaAtual === 'parou') continue;\n\n  const etapaNum = Number(etapaAtual) || 0;\n  const ultimoEnvio = row['Email Data Envio'];\n\n  if (etapaNum === 0) {\n    saida.push({ json: { ...base, acao: 'enviar', etapa_nova: 1, template_id: cfg.template_id_1 } });\n  } else if (etapaNum === 1) {\n    if (diasDesde(ultimoEnvio) >= int2) {\n      saida.push({ json: { ...base, acao: 'enviar', etapa_nova: 2, template_id: cfg.template_id_2 } });\n    }\n  } else if (etapaNum === 2) {\n    if (diasDesde(ultimoEnvio) >= int3) {\n      saida.push({ json: { ...base, acao: 'enviar', etapa_nova: 3, template_id: cfg.template_id_3 } });\n    }\n  }\n  // etapaNum >= 3: cadencia completa, nao insiste mais.\n}\n\nconst limite = num(cfg.limite_envios_por_rodada, 200);\nconst envios = saida.filter((i) => i.json.acao === 'enviar').slice(0, limite);\nconst outros = saida.filter((i) => i.json.acao !== 'enviar');\nreturn [...envios, ...outros];\n"
      },
