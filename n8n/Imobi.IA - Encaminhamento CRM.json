      "parameters": {
        "jsCode": "const j = $input.first().json;\n\n// a listagem devolve payload como array; a criacao devolve a conversa direto\nlet conv = null;\nif (Array.isArray(j.payload)) {\n  const list = j.payload;\n  conv = list.find((c) => c.status === 'open')\n      || list.find((c) => c.status === 'pending')\n      || list[0] || null;\n} else if (j.payload && j.payload.id) conv = j.payload;\nelse if (j.id) conv = j;\n\nif (!conv || !conv.id) {\n  throw new Error('Chatwoot: nao foi possivel obter a conversa. Resposta: ' + JSON.stringify(j).slice(0, 500));\n}\n\nreturn [{ json: { conversation_id: conv.id } }];\n"
      },
